PORT=3001
TERSE_API_KEY=replace-with-a-long-local-secret
RELAY_WORKSPACE_KEY=
# Stable tokens reconnect existing identities; never send these to the browser.
RELAY_COORDINATOR_TOKEN=
RELAY_NAVIGATOR_TOKEN=
RELAY_RESCUER_TOKEN=
# Live Relay retries may exceed the agents' default 20-second command timeout.
AGENT_COMMAND_TIMEOUT_MS=90000
